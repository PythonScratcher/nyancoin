# NyanCoin Docker settings. Copy to .env and edit.

# Your server's public address, so other nodes can connect. Leave EMPTY for a private node.
# Open this TCP port in your firewall. IPv6 example: https://[2001:db8::1]:8001
PUBLIC_URL=https://YOUR.IP.OR.DOMAIN:8001
PORT=8001

# Extra bootstrap peers, space-separated, ideally with their pin:  https://seed.example.com:8001#PIN
PEERS=

# Miner (only runs with:  docker compose --profile mining up -d)
MINER_ADDRESS=
MINER_PROCS=2
